<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.openclaw.cost-report</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-l</string>
		<string>-c</string>
		<string>$HOME/.openclaw/scripts/customer-cost-report.sh >> /tmp/openclaw/cost-report.log 2>&1</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>23</integer>
		<key>Minute</key>
		<integer>45</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/tmp/openclaw/cost-report-stdout.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/openclaw/cost-report-stderr.log</string>
</dict>
</plist>
