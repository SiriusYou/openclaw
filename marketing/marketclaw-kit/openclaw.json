{
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "port": 18789,
    "trustedProxies": []
  },
  "auth": {
    "cooldowns": {
      "billingBackoffHours": 1,
      "billingMaxHours": 12
    }
  },
  "logging": {
    "level": "info",
    "redactSensitive": "tools"
  },
  "diagnostics": {
    "enabled": true,
    "flags": ["gateway.*", "session.*", "webhook.*", "agent.*"]
  },
  "memory": {
    "backend": "builtin",
    "citations": "auto",
    "qmd": {
      "paths": [
        {
          "path": "__WORKSPACE_ROOT__/marketing/memory/",
          "name": "Marketing Knowledge"
        },
        {
          "path": "__WORKSPACE_ROOT__/marketing/strategies/",
          "name": "Campaign Strategies"
        },
        {
          "path": "__WORKSPACE_ROOT__/marketing/performance/",
          "name": "Performance Data"
        },
        {
          "path": "__WORKSPACE_ROOT__/analytics/memory/",
          "name": "Market Research"
        },
        {
          "path": "__WORKSPACE_ROOT__/content/memory/",
          "name": "Content Guidelines"
        }
      ],
      "sessions": {
        "enabled": true,
        "retentionDays": 180
      },
      "update": {
        "interval": "5m",
        "embedInterval": "30m"
      },
      "limits": {
        "maxResults": 10,
        "maxSnippetChars": 500
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "minimax/MiniMax-M2.7-highspeed",
        "fallbacks": ["openai-codex/gpt-5.4", "google/gemini-3.1-pro-preview"]
      },
      "sandbox": {
        "mode": "off"
      }
    },
    "list": [
      {
        "id": "main",
        "default": true,
        "name": "Marketing Orchestrator",
        "workspace": "__WORKSPACE_ROOT__/marketing",
        "model": {
          "primary": "minimax/MiniMax-M2.7-highspeed",
          "fallbacks": ["openai-codex/gpt-5.4", "google/gemini-3.1-pro-preview"]
        },
        "skills": [
          "campaign-brief",
          "content-ab-test",
          "campaign-diagnosis",
          "structured-brainstorm",
          "campaign-lifecycle",
          "content-repurposing",
          "campaign-decision-gate",
          "weekly-summary",
          "campaign-retrospective"
        ],
        "subagents": {
          "allowAgents": ["content-writer", "analyst", "video-maker", "image-maker"],
          "model": {
            "primary": "google/gemini-3-flash-preview",
            "fallbacks": ["openrouter/auto"]
          }
        },
        "tools": {
          "profile": "full",
          "alsoAllow": ["memory_search", "memory_get", "sessions_spawn"]
        },
        "memorySearch": {
          "enabled": true
        },
        "groupChat": {
          "mentionPatterns": ["@orchestrator", "@marketing"]
        },
        "sandbox": {
          "mode": "off"
        }
      },
      {
        "id": "content-writer",
        "name": "Content Writer",
        "workspace": "__WORKSPACE_ROOT__/content",
        "model": {
          "primary": "minimax/MiniMax-M2.7-highspeed",
          "fallbacks": ["openai-codex/gpt-5.4", "google/gemini-3.1-pro-preview"]
        },
        "skills": ["claw1-content-calendar"],
        "tools": {
          "profile": "full",
          "alsoAllow": ["memory_search", "memory_get"]
        },
        "memorySearch": {
          "enabled": true
        },
        "sandbox": {
          "mode": "off"
        }
      },
      {
        "id": "analyst",
        "name": "Marketing Analyst",
        "workspace": "__WORKSPACE_ROOT__/analytics",
        "model": {
          "primary": "minimax/MiniMax-M2.7-highspeed",
          "fallbacks": ["openai-codex/gpt-5.4", "google/gemini-3.1-pro-preview"]
        },
        "skills": ["check-analytics"],
        "tools": {
          "profile": "full",
          "alsoAllow": ["memory_search", "memory_get"]
        },
        "memorySearch": {
          "enabled": true
        },
        "sandbox": {
          "mode": "off"
        }
      },
      {
        "id": "video-maker",
        "name": "Video Creator",
        "workspace": "__WORKSPACE_ROOT__/content",
        "model": {
          "primary": "minimax/MiniMax-M2.7-highspeed",
          "fallbacks": ["openai-codex/gpt-5.4", "google/gemini-3.1-pro-preview"]
        },
        "tools": {
          "profile": "full",
          "alsoAllow": ["memory_search", "memory_get"]
        },
        "memorySearch": {
          "enabled": true
        },
        "sandbox": {
          "mode": "off"
        }
      },
      {
        "id": "image-maker",
        "name": "Image Creator",
        "workspace": "__WORKSPACE_ROOT__/content",
        "model": {
          "primary": "minimax/MiniMax-M2.7-highspeed",
          "fallbacks": ["openai-codex/gpt-5.4", "google/gemini-3.1-pro-preview"]
        },
        "tools": {
          "profile": "full",
          "alsoAllow": ["memory_search", "memory_get"]
        },
        "memorySearch": {
          "enabled": true
        },
        "sandbox": {
          "mode": "off"
        }
      }
    ]
  },
  "bindings": [
    {
      "agentId": "main",
      "match": {
        "channel": "telegram",
        "accountId": "*"
      }
    }
  ],
  "session": {
    "sendPolicy": {
      "default": "deny",
      "rules": [
        {
          "action": "allow",
          "match": {
            "channel": "telegram"
          }
        },
        {
          "action": "allow",
          "match": {
            "rawKeyPrefix": "agent:main:"
          }
        },
        {
          "action": "allow",
          "match": {
            "rawKeyPrefix": "agent:content-writer:"
          }
        },
        {
          "action": "allow",
          "match": {
            "rawKeyPrefix": "agent:analyst:"
          }
        },
        {
          "action": "allow",
          "match": {
            "rawKeyPrefix": "agent:video-maker:"
          }
        },
        {
          "action": "allow",
          "match": {
            "rawKeyPrefix": "agent:image-maker:"
          }
        }
      ]
    }
  },
  "plugins": {
    "enabled": true,
    "entries": {
      "telegram": {
        "enabled": true
      }
    }
  },
  "cron": {
    "enabled": true,
    "maxConcurrentRuns": 3
  },
  "models": {
    "providers": {
      "minimax": {
        "baseUrl": "https://api.minimaxi.com/anthropic",
        "api": "anthropic-messages",
        "authHeader": true,
        "models": [
          {
            "id": "MiniMax-M2.7-highspeed",
            "name": "MiniMax M2.7 Highspeed"
          }
        ]
      }
    }
  }
}
