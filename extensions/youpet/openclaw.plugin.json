{
  "id": "youpet",
  "enabledByDefault": false,
  "activation": {
    "onStartup": true
  },
  "name": "YouPet Core",
  "description": "Consumes YouPet Core outbox deliveries for orchestration actions.",
  "setup": {
    "envVars": [
      "YOUPET_OPENCLAW_ENABLED",
      "YOUPET_CORE_BASE_URL",
      "YOUPET_SERVICE_TOKEN",
      "YOUPET_OPENCLAW_MANAGE_FLOWS"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": false
      },
      "coreBaseUrl": {
        "type": "string"
      },
      "serviceToken": {
        "type": "string"
      },
      "actorId": {
        "type": "string",
        "default": "openclaw-youpet-consumer"
      },
      "outboxConsumer": {
        "type": "string",
        "enum": ["openclaw"],
        "default": "openclaw"
      },
      "outboxLimit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500,
        "default": 20
      },
      "pollIntervalMs": {
        "type": "integer",
        "minimum": 1000,
        "default": 5000
      },
      "ackUnhandledEvents": {
        "type": "boolean",
        "default": true
      },
      "escalateMissedTasks": {
        "type": "boolean",
        "default": true
      },
      "manageFlows": {
        "type": "boolean",
        "default": true
      }
    }
  }
}
